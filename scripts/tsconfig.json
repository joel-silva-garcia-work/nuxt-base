{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../server/**/*.ts",
    "../tests/**/*.ts"
  ],
  "exclude": [
    "../server/plugins/**/*.ts"
  ]
}
